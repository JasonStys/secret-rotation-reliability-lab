+// Jason Stys: actual upstream-package fail-closed regression for the lab-only unsupported Okta boundary.
+package vault
+
+import (
+    "context"
+    "testing"
+
+    "github.com/openbao/openbao/v2/internal/helper/identity/mfa"
+)
+
+func TestLabOktaMFAUnavailable(t *testing.T) {
+    // A nil Core ensures no live service/client is touched; every call must reject, never authenticate.
+    var core *Core
+    canceled, cancel := context.WithCancel(context.Background())
+    cancel()
+    for _, ctx := range []context.Context{context.Background(), canceled} {
+        for _, config := range []*mfa.Config{nil, {Name: "fictional"}} {
+            err := core.validateOkta(ctx, config, "fictional-user")
+            if err == nil || err.Error() != "Okta login MFA is unavailable in this lab build" {
+                t.Fatal("unsupported Okta MFA must fail closed without service access or fallback")
+            }
+        }
+    }
+}
